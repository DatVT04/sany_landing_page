      </div>
      <div class="l-info">
        <div class="l-name">The Meridian</div>
        <div class="l-location">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/><circle cx="12" cy="9" r="2.5"/></svg>
          Quận 1, Ho Chi Minh City
        </div>
        <hr class="l-divider">
        <div class="l-specs">
          <span class="l-spec">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M3 22V8l9-6 9 6v14"/><rect x="9" y="14" width="6" height="8"/></svg>
            4 Bedrooms
          </span>
          <span class="l-spec">3 WC</span>
          <span class="l-spec">320 m²</span>
          <span class="l-price">58 tỷ</span>
        </div>
      </div>
    </a>

    <a href="#" class="l-card reveal d1">
      <div class="l-img-wrap">
        <img src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?w=800&q=85" alt="Sunset Terraces" class="l-img">
        <span class="l-tag outline" data-en="New">Mới</span>
      </div>
      <div class="l-info">
        <div class="l-name">Sunset Terraces</div>
        <div class="l-location"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/><circle cx="12" cy="9" r="2.5"/></svg> Thảo Điền, Quận 2</div>
        <hr class="l-divider">
