        <span class="l-tag" data-en="Hot">Hot</span>
      </div>
      <div class="l-info">
        <div class="l-name">Ivory Residences</div>
        <div class="l-location"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/><circle cx="12" cy="9" r="2.5"/></svg> Phú Mỹ Hưng, Q.7</div>
        <hr class="l-divider">
