<!-- ============================================================
     JAVASCRIPT
     ============================================================ -->
<script>
/* NAVBAR scroll class */
const nav = document.getElementById('nav');
window.addEventListener('scroll', () => {
  nav.classList.toggle('scrolled', window.scrollY > 60);
}, { passive: true });

/* PARALLAX (subtle) */
const parBg = document.getElementById('par-bg');
function onScroll() {
  if (!parBg) return;
  const el = parBg.closest('.parallax-section');
  const r  = el.getBoundingClientRect();
  const p  = r.top / (window.innerHeight + r.height);
  parBg.style.transform = 'translateY(' + (p * 70).toFixed(1) + 'px)';
}
window.addEventListener('scroll', onScroll, { passive: true });

/* FEATURE ACCORDION */
const accItems = document.querySelectorAll('#acc .acc-item');
const featImg  = document.getElementById('feat-img');
const featCapT = document.getElementById('feat-cap-t');
const featCapS = document.getElementById('feat-cap-s');
accItems.forEach(item => {
  item.querySelector('.acc-head').addEventListener('click', () => {
    accItems.forEach(i => {
      i.classList.remove('open');
      i.querySelector('.acc-icon').textContent = '+';
    });
    item.classList.add('open');
    item.querySelector('.acc-icon').textContent = '−';
    if (featImg) {
      featImg.style.opacity = '0';
      setTimeout(() => {
        featImg.src  = item.dataset.img;
        featCapT.innerHTML = item.dataset.t;
        featCapS.innerHTML = item.dataset.s;
        featImg.style.opacity = '1';
      }, 320);
    }
  });
});

/* FAQ ACCORDION */
document.querySelectorAll('.fq-item').forEach(item => {
  item.querySelector('.fq-head').addEventListener('click', () => {
    const isOpen = item.classList.contains('open');
    document.querySelectorAll('.fq-item').forEach(i => {
      i.classList.remove('open');
      i.querySelector('.fq-ico').textContent = '+';
    });
    if (!isOpen) {
      item.classList.add('open');
      item.querySelector('.fq-ico').textContent = '−';
    }
  });
});

/* TESTIMONIALS CAROUSEL */
let cur = 0;
const total = 3;
const track = document.getElementById('test-track');
const dots  = document.querySelectorAll('.test-dot');
const count = document.getElementById('t-count');

function goTo(n) {
  cur = ((n % total) + total) % total;
  track.style.transform = 'translateX(-' + (cur * 100) + '%)';
  dots.forEach((d, i) => d.classList.toggle('active', i === cur));
  count.textContent = String(cur + 1).padStart(2, '0') + ' / ' + String(total).padStart(2, '0');
}

document.getElementById('t-prev').addEventListener('click', () => goTo(cur - 1));
document.getElementById('t-next').addEventListener('click', () => goTo(cur + 1));
dots.forEach(d => d.addEventListener('click', () => goTo(+d.dataset.i)));
const autoPlay = setInterval(() => goTo(cur + 1), 7000);

/* ============================================================
   SCROLL REVEAL (IntersectionObserver — nâng cấp)
   ============================================================ */
const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

const io = new IntersectionObserver((entries) => {
  entries.forEach(e => {
    if (e.isIntersecting) {
      if (prefersReduced) {
        e.target.style.opacity   = '1';
        e.target.style.transform = 'none';
      } else {
        e.target.classList.add('in');
      }
      io.unobserve(e.target);
    }
  });
}, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });

document.querySelectorAll('.reveal, .reveal-l, .reveal-r').forEach(el => io.observe(el));

/* APARTMENT FILTER */
const filterBtns = document.querySelectorAll('.apt-filter-btn');
const aptCards   = document.querySelectorAll('.apt-card');
filterBtns.forEach(btn => {
  btn.addEventListener('click', () => {
    filterBtns.forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    const cat = btn.dataset.filter;
    aptCards.forEach(card => {
      const show = cat === 'all' || card.dataset.cat === cat;
      card.style.display = show ? 'block' : 'none';
    });
  });
});

/* COUNTER ANIMATION for Stats Strip */
const statsIo = new IntersectionObserver(entries => {
  entries.forEach(e => {
    if (e.isIntersecting) {
      e.target.querySelectorAll('.stat-n').forEach(el => {
        const em = el.querySelector('em');
        const suffix = em ? em.textContent : '';
        const num = Number.parseFloat(el.textContent.replaceAll(/[^\d.]/g, ''));
        if (Number.isNaN(num)) return;
        let start = 0;
        const dur = 1800;
        const step = ts => {
          if (!start) start = ts;
          const prog = Math.min((ts - start) / dur, 1);
          const ease = 1 - Math.pow(1 - prog, 3);
          const val  = Math.floor(ease * num);
          el.innerHTML = val.toLocaleString() + (em ? '<em>' + suffix + '</em>' : '');
          if (prog < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      });
      statsIo.unobserve(e.target);
    }
  });
}, { threshold: 0.4 });
document.querySelectorAll('.stats-strip').forEach(el => statsIo.observe(el));

/* ============================================================
   GOOGLE SHEETS INTEGRATION
   ============================================================ */
const GAS_URL = 'https://script.google.com/macros/s/AKfycbxHw6pH-BmxLasThYjpJfbamStwIzXcNL0cXLEaaLXCB6neCFesLIJ4-E-tsTOc0h43/exec';

async function submitToSheet(payload, btnEl, msgEl) {
  if (!payload.name || !payload.phone) {
    showMsg(msgEl, '⚠️ Vui l\xf2ng nhập họ t\xean v\xe0 số điện thoại.', 'warn');
    return;
  }
  const origText = btnEl.textContent;
  btnEl.disabled = true;
  btnEl.textContent = 'Đang gửi...';
  try {
    await fetch(GAS_URL, {
      method : 'POST',
      mode   : 'no-cors',
      headers: { 'Content-Type': 'application/json' },
      body   : JSON.stringify(payload)
    });
    showMsg(msgEl, '✅ Đặt lịch th\xe0nh c\xf4ng! Ch\xfang t\xf4i sẽ li\xean hệ trong 2 giờ.', 'ok');
    btnEl.closest('.hero-form-card, .cta-form')
         .querySelectorAll('input')
         .forEach(i => i.value = '');
  } catch (err) {
    showMsg(msgEl, '❌ C\xf3 lỗi xảy ra, vui l\xf2ng thử lại hoặc gọi hotline.', 'err');
  } finally {
    btnEl.disabled    = false;
    btnEl.textContent = origText;
  }
}

function showMsg(el, text, type) {
  el.textContent = text;
  el.style.display = 'block';
  el.style.background = type === 'ok'
    ? 'rgba(34,197,94,0.18)'
    : type === 'warn'
    ? 'rgba(234,179,8,0.18)'
    : 'rgba(239,68,68,0.18)';
  el.style.color  = type === 'ok' ? '#86efac' : type === 'warn' ? '#fde047' : '#fca5a5';
  el.style.border = '1px solid ' + (type === 'ok' ? 'rgba(34,197,94,0.35)' : type === 'warn' ? 'rgba(234,179,8,0.35)' : 'rgba(239,68,68,0.35)');
  setTimeout(() => { el.style.display = 'none'; }, 6000);
}

/* Hero form */
document.getElementById('hfc-btn').addEventListener('click', () => {
  submitToSheet({
    name  : document.getElementById('hfc-name').value.trim(),
    phone : document.getElementById('hfc-phone').value.trim(),
    email : document.getElementById('hfc-email').value.trim(),
    source: 'hero-form',
    ua    : navigator.userAgent
  }, document.getElementById('hfc-btn'), document.getElementById('hfc-msg'));
});

/* CTA form */
document.getElementById('cta-btn').addEventListener('click', () => {
  submitToSheet({
    name  : document.getElementById('cta-name').value.trim(),
    phone : document.getElementById('cta-phone').value.trim(),
    email : document.getElementById('cta-email').value.trim(),
    source: 'cta-form',
    ua    : navigator.userAgent
  }, document.getElementById('cta-btn'), document.getElementById('cta-msg'));
});

/* ============================================================
   CUSTOM CURSOR (desktop only — fine pointer)
   ============================================================ */
(function initCursor() {
  if (!window.matchMedia('(hover: hover) and (pointer: fine)').matches) return;
  const dot  = document.getElementById('cursor-dot');
  const ring = document.getElementById('cursor-ring');
  if (!dot || !ring) return;

  let mouseX = 0, mouseY = 0;
  let ringX  = 0, ringY  = 0;
  let visible = false;

  document.addEventListener('mousemove', e => {
    mouseX = e.clientX;
    mouseY = e.clientY;
    if (!visible) {
      visible = true;
      dot.style.opacity  = '1';
      ring.style.opacity = '1';
      ringX = mouseX; ringY = mouseY;
    }
    dot.style.left = mouseX + 'px';
    dot.style.top  = mouseY + 'px';
  });

  (function animateRing() {
    const lerp = 0.10;
    ringX += (mouseX - ringX) * lerp;
    ringY += (mouseY - ringY) * lerp;
    ring.style.left = ringX.toFixed(2) + 'px';
    ring.style.top  = ringY.toFixed(2) + 'px';
    requestAnimationFrame(animateRing);
  })();

  const HOVER_SEL = 'a, button, .l-card, .b-card, .apt-card, .acc-item, .bento-cell, .f-soc';
  document.querySelectorAll(HOVER_SEL).forEach(el => {
    el.addEventListener('mouseenter', () => document.body.classList.add('cursor-hover'));
    el.addEventListener('mouseleave', () => document.body.classList.remove('cursor-hover'));
  });

  document.addEventListener('mousedown', () => document.body.classList.add('cursor-click'));
  document.addEventListener('mouseup',   () => document.body.classList.remove('cursor-click'));

  document.addEventListener('mouseleave', () => {
    dot.style.opacity = '0'; ring.style.opacity = '0'; visible = false;
  });
})();

/* ============================================================
   I18N — LANGUAGE TOGGLE (VI / EN)
   ============================================================ */
(function initI18n() {
  const btn = document.getElementById('lang-toggle');
  if (!btn) return;

  function setLang(lang) {
    /* ── Text elements (data-en attribute) ── */
    document.querySelectorAll('[data-en]').forEach(el => {
      if (lang === 'en') {
        if (!el.dataset.vi) el.dataset.vi = el.innerHTML;
        el.innerHTML = el.dataset.en;
      } else {
        if (el.dataset.vi) el.innerHTML = el.dataset.vi;
      }
    });

    /* ── Input placeholders (data-ph-en attribute) ── */
    document.querySelectorAll('[data-ph-en]').forEach(inp => {
      if (lang === 'en') {
        if (!inp.dataset.phVi) inp.dataset.phVi = inp.placeholder;
        inp.placeholder = inp.dataset.phEn;
      } else {
        if (inp.dataset.phVi) inp.placeholder = inp.dataset.phVi;
      }
    });

    /* ── Update button label ── */
    btn.textContent  = lang === 'en' ? 'VI' : 'EN';
    btn.dataset.lang = lang;

    /* ── html lang attr & localStorage ── */
    document.documentElement.lang = lang;
    try { localStorage.setItem('sany_lang', lang); } catch(e) {}
  }

  /* Toggle on click */
  btn.addEventListener('click', () => {
    setLang(btn.dataset.lang === 'vi' ? 'en' : 'vi');
  });

  /* Restore saved language */
  try {
    const saved = localStorage.getItem('sany_lang');
    if (saved === 'en') setLang('en');
  } catch(e) {}
})();
</script>

