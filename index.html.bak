<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Sany Holding — Kiến Tạo Cuộc Sống Đỉnh Cao</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
/* ============================================================
   RESET & BASE
   ============================================================ */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; font-size: 16px; }

/* ============================================================
   DESIGN TOKENS — BRIGHT LUXURY PALETTE
   ============================================================ */
:root {
  /* ── Backgrounds ── */
  --bg-page:       #F9F7F4;
  --bg-white:      #FFFFFF;
  --bg-section:    #F2EDE6;
  --bg-dark:       #111110;
  --bg-dark2:      #1C1A19;

  /* ── Text ── */
  --text-primary:  #18120E;
  --text-secondary:#6B6560;
  --text-light:    #A09890;
  --text-on-dark:  #F9F7F4;
  --text-on-dark2: rgba(249,247,244,0.55);

  /* ── Gold (richer, brighter) ── */
  --gold:          #C9A84C;
  --gold-dark:     #A8893A;
  --gold-light:    #E0C47A;
  --gold-pale:     #F0E4C0;
  --gold-bg:       rgba(201,168,76,0.09);

  /* ── Borders ── */
  --border:        #E8E0D5;
  --border-gold:   rgba(201,168,76,0.28);

  /* ── Typography ── */
  --serif:         'Playfair Display', Georgia, serif;
  --sans:          'Inter', Arial, sans-serif;

  /* ── Shadows (sâu hơn, luxury hơn) ── */
  --shadow-sm:     0 2px 8px rgba(24,18,14,0.07);
  --shadow-md:     0 6px 28px rgba(24,18,14,0.10);
  --shadow-lg:     0 16px 56px rgba(24,18,14,0.13);
  --shadow-gold:   0 8px 32px rgba(201,168,76,0.22);

  /* ── Easing ── */
  --ease:          cubic-bezier(0.25, 0.46, 0.45, 0.94);
  --ease-spring:   cubic-bezier(0.34, 1.56, 0.64, 1);
}

/* ============================================================
   BODY
   ============================================================ */
body {
  background: var(--bg-page);
  color: var(--text-primary);
  font-family: var(--sans);
  font-weight: 400;
  line-height: 1.7;
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
}

/* ============================================================
   SCROLLBAR
   ============================================================ */
::-webkit-scrollbar { width: 4px; }
::-webkit-scrollbar-track { background: var(--bg-section); }
::-webkit-scrollbar-thumb { background: var(--gold); border-radius: 2px; }

/* ============================================================
   NAVBAR
   ============================================================ */
nav {
  position: fixed; top: 0; left: 0; right: 0; z-index: 500;
  display: flex; align-items: center; justify-content: space-between;
  padding: 0 56px; height: 76px;
  transition: all 0.35s var(--ease);
}
nav.scrolled {
  background: rgba(255,255,255,0.94);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  height: 64px;
  border-bottom: 1px solid var(--border);
  box-shadow: var(--shadow-sm);
}
.nav-logo {
  font-family: var(--serif);
  font-size: 19px; font-weight: 600;
  letter-spacing: 0.12em;
  color: var(--text-on-dark);
  text-decoration: none;
  display: flex; align-items: center; gap: 5px;
  transition: color 0.3s;
}
nav.scrolled .nav-logo { color: var(--text-primary); }
.nav-logo-dot {
  width: 6px; height: 6px; border-radius: 50%;
  background: var(--gold);
  flex-shrink: 0; margin-bottom: 1px;
}
.nav-links { display: flex; gap: 40px; list-style: none; }
.nav-links a {
  font-size: 12px; font-weight: 500;
  letter-spacing: 0.14em; text-transform: uppercase;
  text-decoration: none;
  color: rgba(248,245,239,0.7);
  transition: color 0.25s;
}
nav.scrolled .nav-links a { color: var(--text-secondary); }
.nav-links a:hover { color: var(--gold) !important; }
.nav-links a:not(.nav-cta)::after {
  content: ''; display: block;
  width: 0; height: 1px;
  background: var(--gold);
  transition: width 0.28s var(--ease);
  margin-top: 2px;
}
.nav-links a:not(.nav-cta):hover::after { width: 100%; }
.nav-cta {
  background: var(--gold);
  color: #fff !important;
  padding: 11px 24px;
  border-radius: 4px;
  font-size: 11px !important;
  letter-spacing: 0.16em !important;
  transition: background 0.25s !important;
}
.nav-cta:hover { background: var(--gold-dark) !important; }
nav.scrolled .nav-cta { color: #fff !important; }

/* ============================================================
   HERO — split layout
   ============================================================ */
.hero {
  height: 100vh; min-height: 720px;
  position: relative;
  display: flex; align-items: flex-end;
  overflow: hidden;
}
.hero-img {
  position: absolute; inset: 0;
  background: url('https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?w=2000&q=85') center/cover no-repeat;
  transform: scale(1.06);
  animation: heroZoom 14s var(--ease) forwards;
}
@keyframes heroZoom { to { transform: scale(1); } }
.hero-gradient {
  position: absolute; inset: 0;
  background:
    linear-gradient(180deg,
      rgba(17,17,16,0.28) 0%,
      transparent        35%,
      rgba(17,17,16,0.50) 65%,
      rgba(17,17,16,0.92) 100%),
    linear-gradient(90deg,
      rgba(17,17,16,0.45) 0%,
      rgba(17,17,16,0.05) 60%);
}
.hero-content {
  position: relative; z-index: 2;
  width: 100%;
  padding: 0 72px 88px;
  display: grid;
  grid-template-columns: 1fr 420px;
  gap: 64px;
  align-items: flex-end;
}
.hero-eyebrow {
  display: flex; align-items: center; gap: 14px;
  margin-bottom: 26px;
  opacity: 0; animation: fadeUp 0.85s 0.15s both;
}
.hero-eyebrow-bar { width: 32px; height: 1px; background: var(--gold-light); }
.hero-eyebrow span {
  font-size: 10.5px; font-weight: 500;
  letter-spacing: 0.3em; text-transform: uppercase;
  color: var(--gold-light);
}
.hero-h1 {
  font-family: var(--serif);
  font-size: clamp(48px, 6.5vw, 96px);
  font-weight: 400; line-height: 0.96;
  letter-spacing: -0.018em;
  color: #fff;
  margin-bottom: 28px;
  opacity: 0; animation: fadeUp 0.85s 0.3s both;
}
.hero-h1 em { font-style: italic; color: var(--gold-light); }
.hero-h1 .indent { display: block; padding-left: 72px; }
.hero-desc {
  font-size: 15px; color: rgba(255,255,255,0.62);
  max-width: 400px; line-height: 1.9;
  opacity: 0; animation: fadeUp 0.85s 0.45s both;
}
.hero-cta-row {
  display: flex; align-items: center; gap: 18px;
  margin-top: 36px;
  opacity: 0; animation: fadeUp 0.85s 0.58s both;
}
.hero-stats {
  display: flex; gap: 0;
  margin-top: 48px;
  padding-top: 36px;
  border-top: 1px solid rgba(255,255,255,0.1);
  opacity: 0; animation: fadeUp 0.85s 0.72s both;
}
.h-stat { padding: 0 32px; border-left: 1px solid rgba(255,255,255,0.12); }
.h-stat:first-child { border-left: none; padding-left: 0; }
.h-stat-n {
  font-family: var(--serif); font-size: 34px; font-weight: 400;
  color: #fff; line-height: 1;
}
.h-stat-n sup { font-size: 14px; color: var(--gold-light); }
.h-stat-l {
  font-size: 9.5px; letter-spacing: 0.22em; text-transform: uppercase;
  color: rgba(255,255,255,0.4); margin-top: 6px;
}

/* Buttons */
.btn-primary {
  background: var(--gold);
  color: #fff;
  padding: 16px 36px;
  border-radius: 4px;
  font-family: var(--sans);
  font-size: 11.5px; font-weight: 600;
  letter-spacing: 0.18em; text-transform: uppercase;
  text-decoration: none; border: none; cursor: pointer;
  transition: background 0.25s, transform 0.2s;
  display: inline-block;
}
.btn-primary:hover { background: var(--gold-dark); transform: translateY(-2px); }
.btn-secondary {
  color: rgba(255,255,255,0.8);
  font-size: 12.5px; font-weight: 400;
  letter-spacing: 0.1em;
  text-decoration: none;
  display: flex; align-items: center; gap: 10px;
  transition: color 0.25s;
}
.btn-secondary:hover { color: var(--gold-light); }
.btn-secondary-circle {
  width: 42px; height: 42px; border-radius: 50%;
  border: 1px solid rgba(255,255,255,0.28);
  display: flex; align-items: center; justify-content: center;
  transition: border-color 0.25s;
}
.btn-secondary:hover .btn-secondary-circle { border-color: var(--gold-light); }

/* Glassmorphism Booking Card */
.hero-form-card {
  background: rgba(255,255,255,0.10);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(255,255,255,0.18);
  border-radius: 20px;
  padding: 36px 32px 32px;
  opacity: 0; animation: fadeUp 0.85s 0.5s both;
  box-shadow: 0 24px 72px rgba(0,0,0,0.28);
}
.hfc-title {
  font-family: var(--serif);
  font-size: 22px; font-weight: 500;
  color: #fff; margin-bottom: 6px; line-height: 1.2;
}
.hfc-sub {
  font-size: 12px; color: rgba(255,255,255,0.5);
  margin-bottom: 24px; letter-spacing: 0.04em;
}
.hfc-label {
  font-size: 10px; letter-spacing: 0.2em; text-transform: uppercase;
  color: rgba(255,255,255,0.45); display: block;
  margin-bottom: 7px; font-weight: 500;
}
.hfc-input {
  width: 100%;
  background: rgba(255,255,255,0.08);
  border: 1px solid rgba(255,255,255,0.16);
  border-radius: 8px;
  color: #fff; font-family: var(--sans); font-size: 14px;
  padding: 13px 16px; outline: none;
  transition: border-color 0.25s, background 0.25s;
  margin-bottom: 14px;
}
.hfc-input::placeholder { color: rgba(255,255,255,0.32); }
.hfc-input:focus { border-color: var(--gold-light); background: rgba(255,255,255,0.13); }
.hfc-select {
  width: 100%;
  background: rgba(255,255,255,0.08);
  border: 1px solid rgba(255,255,255,0.16);
  border-radius: 8px;
  color: rgba(255,255,255,0.7); font-family: var(--sans); font-size: 14px;
  padding: 13px 16px; outline: none; cursor: pointer;
  margin-bottom: 20px;
  -webkit-appearance: none;
  appearance: none;
}
.hfc-select option { background: #1C1A19; color: #fff; }
.hfc-submit {
  width: 100%;
  background: var(--gold);
  color: #fff; border: none;
  padding: 15px; border-radius: 8px;
  font-family: var(--sans); font-size: 11.5px;
  font-weight: 600; letter-spacing: 0.2em;
  text-transform: uppercase; cursor: pointer;
  transition: background 0.25s, transform 0.2s, box-shadow 0.25s;
}
.hfc-submit:hover {
  background: var(--gold-dark);
  transform: translateY(-2px);
  box-shadow: var(--shadow-gold);
}
.hfc-note {
  text-align: center; margin-top: 14px;
  font-size: 10.5px; color: rgba(255,255,255,0.3);
  letter-spacing: 0.05em;
}
.hfc-divider {
  display: flex; align-items: center; gap: 12px;
  margin: 18px 0 16px;
}
.hfc-divider::before, .hfc-divider::after {
  content: ''; flex: 1; height: 1px;
  background: rgba(255,255,255,0.12);
}
.hfc-divider span { font-size: 10px; color: rgba(255,255,255,0.3); letter-spacing: 0.1em; }

/* Scroll indicator */
.scroll-hint {
  position: absolute; bottom: 36px; left: 80px; z-index: 2;
  display: flex; flex-direction: column; align-items: center; gap: 8px;
  opacity: 0; animation: fadeIn 1s 1.3s both;
}
.scroll-hint span {
  font-size: 9px; letter-spacing: 0.3em; text-transform: uppercase;
  color: rgba(255,255,255,0.35);
  writing-mode: vertical-rl; transform: rotate(180deg);
}
.scroll-line {
  width: 1px; height: 52px;
  background: linear-gradient(var(--gold-light), transparent);
  animation: scrollAnim 2s 1.5s infinite;
}
@keyframes scrollAnim {
  0%, 100% { opacity: 0.4; transform: scaleY(1); }
  50% { opacity: 1; transform: scaleY(0.6); }
}

@keyframes fadeUp {
  from { opacity: 0; transform: translateY(28px); }
  to   { opacity: 1; transform: translateY(0); }
}
@keyframes fadeIn {
  from { opacity: 0; } to { opacity: 1; }
}

/* ============================================================
   TICKER STRIP
   ============================================================ */
.ticker-wrap {
  background: var(--bg-white);
  border-bottom: 1px solid var(--border);
  overflow: hidden; padding: 16px 0;
  white-space: nowrap;
}
.ticker-track {
  display: inline-flex; gap: 0;
  animation: ticker 28s linear infinite;
}
@keyframes ticker { to { transform: translateX(-50%); } }
.t-item {
  display: inline-flex; align-items: center; gap: 24px;
  padding: 0 36px;
  font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase;
  color: var(--text-secondary); font-weight: 500;
}
.t-dot { width: 4px; height: 4px; border-radius: 50%; background: var(--gold); flex-shrink: 0; }
.t-item strong { color: var(--gold); font-weight: 600; }

/* ============================================================
   SHARED SECTION UTILITIES
   ============================================================ */
.section-label {
  display: inline-flex; align-items: center; gap: 12px;
  font-size: 10.5px; letter-spacing: 0.28em; text-transform: uppercase;
  color: var(--gold); font-weight: 500; margin-bottom: 20px;
}
.section-label::before {
  content: ''; width: 24px; height: 1px; background: var(--gold);
}
.section-title {
  font-family: var(--serif);
  font-size: clamp(36px, 4.5vw, 62px);
  font-weight: 400; line-height: 1.08;
  color: var(--text-primary);
  letter-spacing: -0.01em;
}
.section-title em { font-style: italic; color: var(--gold); }
.section-sub {
  font-size: 14.5px; color: var(--text-secondary);
  max-width: 480px; line-height: 1.85; margin-top: 16px;
}

/* ============================================================
   SCROLL REVEAL
   ============================================================ */
.reveal {
  opacity: 0;
  transform: translateY(30px);
  transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1),
              transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
}
.reveal.in { opacity: 1; transform: translateY(0); }

.reveal-l {
  opacity: 0; transform: translateX(-30px);
  transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1),
              transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
}
.reveal-l.in { opacity: 1; transform: translateX(0); }

.reveal-r {
  opacity: 0; transform: translateX(30px);
  transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1),
              transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
}
.reveal-r.in { opacity: 1; transform: translateX(0); }

/* Stagger delay classes */
.d1 { transition-delay: 0.10s; } .d2 { transition-delay: 0.20s; }
.d3 { transition-delay: 0.30s; } .d4 { transition-delay: 0.40s; }
.d5 { transition-delay: 0.50s; } .d6 { transition-delay: 0.60s; }

/* ============================================================
   LANG TOGGLE BUTTON
   ============================================================ */
.lang-btn {
  background: transparent;
  border: 1px solid var(--border-gold);
  color: var(--text-on-dark);
  font-family: var(--sans);
  font-size: 10.5px;
  letter-spacing: 0.14em;
  font-weight: 600;
  padding: 5px 13px;
  border-radius: 20px;
  cursor: pointer;
  transition: border-color 0.25s, color 0.25s, background 0.25s;
  text-transform: uppercase;
  margin-left: 10px;
  flex-shrink: 0;
}
.lang-btn:hover { border-color: var(--gold); color: var(--gold); }
nav.scrolled .lang-btn { color: var(--text-secondary); border-color: var(--border); }
nav.scrolled .lang-btn:hover { border-color: var(--gold); color: var(--gold); }

/* Accessibility: tắt animation nếu user bật reduced motion */
@media (prefers-reduced-motion: reduce) {
  .reveal, .reveal-l, .reveal-r {
    opacity: 1 !important;
    transform: none !important;
    transition: none !important;
  }
}

/* ============================================================
   CUSTOM CURSOR (chỉ hiện trên desktop có fine pointer)
   ============================================================ */
@media (hover: hover) and (pointer: fine) {
  /* Ẩn cursor mặc định trên toàn trang */
  *, *::before, *::after { cursor: none !important; }

  #cursor-dot {
    position: fixed;
    width: 8px; height: 8px;
    background: var(--gold);
    border-radius: 50%;
    pointer-events: none;
    z-index: 9999;
    top: 0; left: 0;
    transform: translate(-50%, -50%);
    opacity: 0;                        /* ẩn đến khi mouse move */
    transition: width 0.25s var(--ease-spring),
                height 0.25s var(--ease-spring),
                background 0.25s,
                opacity 0.3s,
                transform 0.15s;
    will-change: left, top;
  }

  #cursor-ring {
    position: fixed;
    width: 38px; height: 38px;
    border: 1.5px solid rgba(201,168,76,0.75);
    border-radius: 50%;
    pointer-events: none;
    z-index: 9998;
    top: 0; left: 0;
    transform: translate(-50%, -50%);
    opacity: 0;
    mix-blend-mode: difference;
    transition: width 0.4s var(--ease-spring),
                height 0.4s var(--ease-spring),
                border-color 0.3s,
                opacity 0.3s;
    will-change: left, top;
  }

  /* Hover state — phóng to ring + đổi màu dot */
  body.cursor-hover #cursor-dot {
    width: 6px; height: 6px;
    background: var(--gold-light);
  }
  body.cursor-hover #cursor-ring {
    width: 60px; height: 60px;
    border-color: rgba(224,196,122,0.9);
  }

  /* Click state — thu nhỏ */
  body.cursor-click #cursor-dot {
    transform: translate(-50%, -50%) scale(0.7);
  }
  body.cursor-click #cursor-ring {
    width: 28px; height: 28px;
  }
}

/* ============================================================
   LISTINGS SECTION
   ============================================================ */
.listings-section {
  padding: 100px 56px 120px;
  background: var(--bg-page);
}
.section-header {
  display: flex; justify-content: space-between; align-items: flex-end;
  margin-bottom: 64px; gap: 32px;
}
.view-all {
  font-size: 11.5px; letter-spacing: 0.14em; text-transform: uppercase;
  color: var(--text-secondary); text-decoration: none; font-weight: 500;
  display: flex; align-items: center; gap: 10px;
  transition: color 0.25s;
}
.view-all::after {
  content: ''; width: 28px; height: 1px;
  background: currentColor; transition: width 0.3s;
}
.view-all:hover { color: var(--gold); }
.view-all:hover::after { width: 44px; }

/* Listing grid — editorial masonry feel */
.listing-grid {
  display: grid;
  grid-template-columns: 1.35fr 1fr 1fr;
  grid-template-rows: auto auto;
  gap: 20px;
}
.l-card {
  background: var(--bg-white);
  border-radius: 12px;
  overflow: hidden;
  border: 1px solid var(--border);
  text-decoration: none; color: inherit; display: block;
  transition: transform 0.35s var(--ease), box-shadow 0.35s var(--ease), border-color 0.35s;
  box-shadow: var(--shadow-sm);
}
.l-card:hover {
  transform: translateY(-6px);
  box-shadow: var(--shadow-lg);
  border-color: var(--gold-pale);
}
.l-card.featured { grid-row: 1 / 3; display: flex; flex-direction: column; }
.l-card.featured .l-img-wrap { flex: 1; }
.l-img-wrap { position: relative; overflow: hidden; }
.l-img {
  width: 100%; height: 260px; object-fit: cover; display: block;
  transition: transform 0.55s var(--ease);
}
.l-card.featured .l-img { height: 100%; min-height: 400px; max-height: 520px; }
.l-card:hover .l-img { transform: scale(1.05); }
.l-tag {
  position: absolute; top: 14px; left: 14px;
  background: var(--gold); color: #fff;
  font-size: 9.5px; letter-spacing: 0.16em; text-transform: uppercase;
  font-weight: 600; padding: 5px 12px; border-radius: 3px;
}
.l-tag.outline {
  background: transparent;
  border: 1px solid var(--gold);
  color: var(--gold);
}
.l-info { padding: 22px 24px 24px; }
.l-name {
  font-family: var(--serif);
  font-size: 20px; font-weight: 500;
  color: var(--text-primary); margin-bottom: 5px; line-height: 1.2;
}
.l-card.featured .l-name { font-size: 26px; }
.l-location {
  font-size: 12px; color: var(--text-secondary);
  margin-bottom: 16px; display: flex; align-items: center; gap: 5px;
}
.l-divider { border: none; border-top: 1px solid var(--border); margin-bottom: 16px; }
.l-specs {
  display: flex; align-items: center; gap: 14px; flex-wrap: wrap;
}
.l-spec {
  font-size: 11.5px; color: var(--text-secondary);
  display: flex; align-items: center; gap: 5px;
}
.l-spec svg { color: var(--gold); opacity: 0.8; }
.l-price {
  font-family: var(--serif);
  font-size: 20px; font-weight: 500; color: var(--gold);
  margin-left: auto;
}
.l-card.featured .l-price { font-size: 26px; }

/* ============================================================
   AMENITIES — Bento Grid
   ============================================================ */
.amenities-wrap {
  background: var(--bg-section);
  padding: 100px 56px 100px;
}
.bento-grid {
  display: grid;
  grid-template-columns: repeat(12, 1fr);
  grid-template-rows: 280px 200px 240px;
  gap: 14px;
  margin-top: 60px;
}
.bento-cell { border-radius: 20px; overflow: hidden; position: relative; }
.bento-cell.c-1 { grid-column: span 5; grid-row: span 2; }
.bento-cell.c-2 { grid-column: span 4; grid-row: span 1; }
.bento-cell.c-3 { grid-column: span 3; grid-row: span 1; }
.bento-cell.c-4 { grid-column: span 4; grid-row: span 1; }
.bento-cell.c-5 { grid-column: span 3; grid-row: span 1; }
.bento-cell.c-6 { grid-column: span 7; grid-row: span 1; }
.bento-cell.c-7 { grid-column: span 5; grid-row: span 1; }
.bento-cell.img-cell .b-img {
  width: 100%; height: 100%; object-fit: cover; display: block;
  transition: transform 0.6s var(--ease), filter 0.4s;
  filter: brightness(0.80);
}
.bento-cell.img-cell:hover .b-img { transform: scale(1.06); filter: brightness(0.65); }
.b-overlay {
  position: absolute; inset: 0;
  background: linear-gradient(to top, rgba(0,0,0,0.6) 0%, transparent 55%);
  pointer-events: none;
}
.b-label {
  position: absolute; bottom: 20px; left: 22px; right: 22px;
  color: #fff;
}
.b-label-name {
  font-family: var(--serif); font-size: 20px; font-weight: 500;
  line-height: 1.2;
}
.b-label-sub { font-size: 11px; color: rgba(255,255,255,0.6); margin-top: 4px; letter-spacing: 0.08em; }
.b-pill {
  position: absolute; top: 16px; right: 16px;
  background: rgba(255,255,255,0.15);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1px solid rgba(255,255,255,0.22);
  border-radius: 50px; padding: 6px 16px;
  font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase;
  color: #fff; font-weight: 500;
}
.bento-cell.stat-cell {
  background: var(--bg-white);
  border: 1px solid var(--border);
  display: flex; flex-direction: column;
  justify-content: space-between;
  padding: 28px 28px 24px;
  box-shadow: var(--shadow-sm);
  transition: transform 0.3s var(--ease), box-shadow 0.3s;
}
.bento-cell.stat-cell:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); }
.bento-cell.gold-cell {
  background: var(--gold);
  border: none;
}
.b-stat-icon {
  width: 44px; height: 44px; border-radius: 12px;
  background: var(--gold-bg); border: 1px solid var(--border-gold);
  display: flex; align-items: center; justify-content: center;
}
.b-stat-icon svg { width: 22px; height: 22px; stroke: var(--gold); fill: none; stroke-width: 1.5; }
.bento-cell.gold-cell .b-stat-icon { background: rgba(255,255,255,0.2); border-color: rgba(255,255,255,0.25); }
.bento-cell.gold-cell .b-stat-icon svg { stroke: #fff; }
.b-stat-n {
  font-family: var(--serif); font-size: 42px; font-weight: 400;
  color: var(--text-primary); line-height: 1;
}
.b-stat-n em { font-style: italic; color: var(--gold); }
.bento-cell.gold-cell .b-stat-n { color: #fff; }
.bento-cell.gold-cell .b-stat-n em { color: rgba(255,255,255,0.7); }
.b-stat-label {
  font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase;
  color: var(--text-secondary); font-weight: 500;
}
.bento-cell.gold-cell .b-stat-label { color: rgba(255,255,255,0.7); }
@media (max-width: 1100px) {
  .bento-grid {
    grid-template-columns: repeat(6, 1fr);
    grid-template-rows: 240px 180px 200px 180px;
  }
  .bento-cell.c-1 { grid-column: span 6; grid-row: span 1; }
  .bento-cell.c-2 { grid-column: span 3; }
  .bento-cell.c-3 { grid-column: span 3; }
  .bento-cell.c-4 { grid-column: span 4; }
  .bento-cell.c-5 { grid-column: span 2; }
  .bento-cell.c-6 { grid-column: span 6; }
  .bento-cell.c-7 { grid-column: span 6; }
}
@media (max-width: 768px) {
  .bento-grid { grid-template-columns: 1fr 1fr; grid-template-rows: auto; }
  .bento-cell.c-1, .bento-cell.c-6 { grid-column: span 2; height: 220px; }
  .bento-cell.c-2, .bento-cell.c-4 { grid-column: span 1; height: 180px; }
  .bento-cell.c-3, .bento-cell.c-5, .bento-cell.c-7 { grid-column: span 1; height: 160px; }
}

/* ============================================================
   STATS STRIP (light version)
   ============================================================ */
.stats-strip {
  background: var(--bg-white);
  border-top: 1px solid var(--border);
  border-bottom: 1px solid var(--border);
  padding: 70px 56px;
}
.stats-inner {
  display: grid; grid-template-columns: repeat(4, 1fr);
  gap: 0;
  max-width: 1100px; margin: 0 auto;
}
.stat-block {
  text-align: center; padding: 0 32px;
  border-right: 1px solid var(--border);
}
.stat-block:last-child { border-right: none; }
.stat-n {
  font-family: var(--serif);
  font-size: 56px; font-weight: 400;
  color: var(--text-primary); line-height: 1;
}
.stat-n em { font-style: italic; color: var(--gold); }
.stat-l {
  font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase;
  color: var(--text-secondary); margin-top: 10px; font-weight: 500;
}

/* ============================================================
   FEATURES SECTION
   ============================================================ */
.features-section {
  background: var(--bg-page);
  display: grid; grid-template-columns: 1fr 1fr;
  min-height: 750px;
}
.feat-visual { position: relative; overflow: hidden; }
.feat-img {
  width: 100%; height: 100%; object-fit: cover; display: block;
  transition: opacity 0.5s var(--ease);
}
.feat-caption {
  position: absolute; bottom: 28px; left: 28px; right: 28px;
  background: rgba(255,255,255,0.92);
  backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
  border: 1px solid var(--border);
  border-radius: 10px; padding: 20px 24px;
}
.feat-cap-title {
  font-family: var(--serif);
  font-size: 18px; font-weight: 500; color: var(--text-primary);
}
.feat-cap-sub { font-size: 12px; color: var(--text-secondary); margin-top: 4px; }

.feat-content {
  padding: 80px 72px;
  display: flex; flex-direction: column; justify-content: center;
  background: var(--bg-page);
}
.acc-list { margin-top: 44px; }
.acc-item { border-bottom: 1px solid var(--border); }
.acc-head {
  display: flex; justify-content: space-between; align-items: center;
  padding: 22px 0; cursor: pointer; gap: 16px;
}
.acc-num {
  font-family: var(--serif);
  font-size: 13px; font-weight: 400;
  color: var(--gold); min-width: 26px;
}
.acc-title {
  font-family: var(--serif);
  font-size: 19px; font-weight: 400;
  color: var(--text-secondary);
  transition: color 0.25s; flex: 1;
}
.acc-item.open .acc-title { color: var(--text-primary); }
.acc-icon {
  width: 32px; height: 32px; border-radius: 50%;
  border: 1px solid var(--border);
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0; font-size: 20px; color: var(--text-secondary);
  transition: all 0.25s; line-height: 1; background: var(--bg-white);
}
.acc-item.open .acc-icon {
  background: var(--gold); border-color: var(--gold); color: #fff;
}
.acc-body {
  max-height: 0; overflow: hidden;
  transition: max-height 0.45s var(--ease);
  padding-left: 26px;
}
.acc-item.open .acc-body { max-height: 160px; }
.acc-body p {
  font-size: 14px; color: var(--text-secondary);
  line-height: 1.85; padding-bottom: 22px;
}

/* ============================================================
   PARALLAX DIVIDER — warm, not dark
   ============================================================ */
.parallax-section {
  position: relative; height: 520px;
  overflow: hidden;
  display: flex; align-items: center; justify-content: center;
}
.parallax-bg {
  position: absolute; inset: -15%;
  background: url('https://images.unsplash.com/photo-1512917774080-9991f1c4c750?w=2000&q=80') center/cover no-repeat;
  filter: brightness(0.45);
}
.parallax-content {
  position: relative; z-index: 2;
  text-align: center; padding: 0 40px;
}
.parallax-quote {
  font-family: var(--serif);
  font-size: clamp(26px, 4vw, 52px);
  font-weight: 400; font-style: italic;
  color: #fff; line-height: 1.35;
  max-width: 820px; margin: 0 auto 36px;
}
.parallax-quote strong { font-style: normal; color: var(--gold-light); }

/* ============================================================
   TESTIMONIALS
   ============================================================ */
.testimonials-section {
  background: var(--bg-section);
  padding: 110px 0 100px;
  overflow: hidden;
}
.test-header {
  padding: 0 56px;
  display: flex; justify-content: space-between; align-items: flex-end;
  margin-bottom: 64px;
}
.test-track-wrap { position: relative; }
.test-track {
  display: flex;
  transition: transform 0.7s var(--ease);
}
.test-slide {
  min-width: 100%; padding: 0 56px;
  display: grid; grid-template-columns: 220px 1fr;
  gap: 80px; align-items: center;
}
.test-avatar-ring {
  width: 120px; height: 120px; border-radius: 50%;
  border: 2px solid var(--gold-pale);
  overflow: hidden; margin: 0 auto 18px;
}
.test-avatar { width: 100%; height: 100%; object-fit: cover; display: block; }
.test-left { text-align: center; }
.test-name {
  font-family: var(--serif);
  font-size: 20px; font-weight: 500; color: var(--text-primary);
}
.test-role {
  font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase;
  color: var(--gold); margin-top: 5px; font-weight: 500;
}
.test-stars { color: var(--gold); font-size: 15px; letter-spacing: 3px; margin-top: 12px; }
.test-quote {
  font-family: var(--serif);
  font-size: clamp(20px, 2.8vw, 34px);
  font-weight: 400; font-style: italic;
  color: var(--text-primary); line-height: 1.5;
}
.test-quote::before { content: '\201C'; color: var(--gold); }
.test-quote::after  { content: '\201D'; color: var(--gold); }
.test-controls {
  display: flex; align-items: center; gap: 16px;
  padding: 0 56px; margin-top: 52px;
}
.test-btn {
  width: 48px; height: 48px; border-radius: 50%;
  border: 1px solid var(--border);
  background: var(--bg-white);
  display: flex; align-items: center; justify-content: center;
  cursor: pointer; color: var(--text-secondary);
  transition: all 0.25s; box-shadow: var(--shadow-sm);
}
.test-btn:hover { border-color: var(--gold); color: var(--gold); }
.test-dots { display: flex; gap: 8px; }
.test-dot {
  width: 7px; height: 7px; border-radius: 4px;
  background: var(--border); border: none; cursor: pointer;
  transition: all 0.35s var(--ease); padding: 0;
}
.test-dot.active { width: 28px; background: var(--gold); }
.test-count {
  margin-left: auto;
  font-family: var(--serif); font-size: 14px; font-style: italic;
  color: var(--text-light);
}

/* ============================================================
   BLOG
   ============================================================ */
.blog-section { padding: 110px 56px; background: var(--bg-white); }
.blog-grid {
  display: grid;
  grid-template-columns: 2fr 1fr;
  grid-template-rows: auto auto;
  gap: 20px;
}
.b-card {
  background: var(--bg-white);
  border-radius: 12px; overflow: hidden;
  border: 1px solid var(--border);
  box-shadow: var(--shadow-sm);
  text-decoration: none; color: inherit; display: block;
  transition: transform 0.35s var(--ease), box-shadow 0.35s var(--ease), border-color 0.35s;
}
.b-card:hover { transform: translateY(-5px); box-shadow: var(--shadow-lg); border-color: var(--gold-pale); }
.b-card.featured { grid-row: 1 / 3; display: flex; flex-direction: column; }
.b-card.featured .b-img-wrap { flex: 1; }
.b-img-wrap { overflow: hidden; }
.b-img {
  width: 100%; height: 220px; object-fit: cover; display: block;
  transition: transform 0.55s var(--ease);
}
.b-card.featured .b-img { height: 100%; min-height: 260px; }
.b-card:hover .b-img { transform: scale(1.04); }
.b-info { padding: 22px 24px; }
.b-cat {
  font-size: 10.5px; letter-spacing: 0.2em; text-transform: uppercase;
  color: var(--gold); margin-bottom: 10px; font-weight: 500;
}
.b-title {
  font-family: var(--serif);
  font-size: 19px; font-weight: 500;
  color: var(--text-primary); line-height: 1.3; margin-bottom: 12px;
}
.b-card.featured .b-title { font-size: 26px; }
.b-meta { font-size: 12px; color: var(--text-light); display: flex; gap: 14px; }

/* ============================================================
   PROCESS
   ============================================================ */
.process-section { padding: 110px 56px; background: var(--bg-section); }
.process-grid {
  display: grid; grid-template-columns: repeat(3, 1fr);
  gap: 16px; margin-top: 64px;
}
.p-step {
  background: var(--bg-white);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 40px 36px;
  position: relative; overflow: hidden;
  transition: transform 0.3s var(--ease), border-color 0.3s, box-shadow 0.3s;
  box-shadow: var(--shadow-sm);
}
.p-step:hover {
  transform: translateY(-4px);
  border-color: var(--gold-pale);
  box-shadow: var(--shadow-md);
}
.p-step::before {
  content: '';
  position: absolute; left: 0; top: 0; bottom: 0;
  width: 3px; background: var(--gold);
  opacity: 0; transition: opacity 0.3s;
  border-radius: 3px 0 0 3px;
}
.p-step:hover::before { opacity: 1; }
.p-num {
  font-family: var(--serif);
  font-size: 72px; font-weight: 400;
  color: var(--gold-pale);
  line-height: 1; margin-bottom: 20px;
  position: absolute; top: 14px; right: 20px;
}
.p-icon {
  width: 48px; height: 48px; border-radius: 10px;
  background: var(--gold-bg);
  border: 1px solid var(--border-gold);
  display: flex; align-items: center; justify-content: center;
  margin-bottom: 20px;
}
.p-icon svg { width: 22px; height: 22px; stroke: var(--gold); fill: none; stroke-width: 1.5; }
.p-title {
  font-family: var(--serif);
  font-size: 20px; font-weight: 500;
  color: var(--text-primary); margin-bottom: 12px;
}
.p-desc { font-size: 13.5px; color: var(--text-secondary); line-height: 1.85; }

/* ============================================================
   FAQ
   ============================================================ */
.faq-section { padding: 110px 56px; background: var(--bg-white); }
.faq-inner { display: grid; grid-template-columns: 1fr 2fr; gap: 110px; align-items: start; }
.faq-cta-btn {
  display: inline-block;
  border: 1.5px solid var(--gold); color: var(--gold);
  padding: 14px 28px; border-radius: 4px;
  font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase;
  text-decoration: none; font-weight: 500;
  transition: background 0.25s, color 0.25s;
  margin-top: 36px;
}
.faq-cta-btn:hover { background: var(--gold); color: #fff; }
.fq-item { border-bottom: 1px solid var(--border); }
.fq-head {
  display: flex; justify-content: space-between; align-items: center;
  padding: 22px 0; cursor: pointer; gap: 16px;
}
.fq-q {
  font-family: var(--serif);
  font-size: 18px; font-weight: 400;
  color: var(--text-secondary); transition: color 0.25s; flex: 1;
}
.fq-item.open .fq-q { color: var(--text-primary); }
.fq-ico {
  width: 30px; height: 30px; border-radius: 50%;
  border: 1px solid var(--border);
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0; font-size: 20px; color: var(--text-secondary);
  transition: all 0.3s; line-height: 1;
  background: var(--bg-white);
}
.fq-item.open .fq-ico { background: var(--gold); border-color: var(--gold); color: #fff; }
.fq-a {
  max-height: 0; overflow: hidden;
  transition: max-height 0.45s var(--ease);
  font-size: 14px; color: var(--text-secondary); line-height: 1.9;
}
.fq-item.open .fq-a { max-height: 180px; padding-bottom: 22px; }

/* ============================================================
   CTA CONTACT SECTION
   ============================================================ */
.cta-section {
  position: relative; overflow: hidden;
  padding: 130px 56px;
  text-align: center;
}
.cta-bg {
  position: absolute; inset: 0;
  background: url('https://images.unsplash.com/photo-1600566753086-00f18fb6b3ea?w=2000&q=80') center/cover no-repeat;
  filter: brightness(0.3) saturate(0.8);
}
/* Warm tint, not pure black */
.cta-overlay {
  position: absolute; inset: 0;
  background: rgba(43,32,18,0.72);
}
.cta-content { position: relative; z-index: 2; }
.cta-eyebrow {
  font-size: 10px; letter-spacing: 0.35em; text-transform: uppercase;
  color: var(--gold-light); margin-bottom: 28px;
  display: block; font-weight: 500;
}
.cta-title {
  font-family: var(--serif);
  font-size: clamp(44px, 6.5vw, 88px);
  font-weight: 400; line-height: 0.97; letter-spacing: -0.01em;
  color: #fff; margin-bottom: 44px;
}
.cta-title em { font-style: italic; color: var(--gold-light); }
.cta-form {
  display: flex; flex-direction: column; gap: 10px;
  max-width: 520px; margin: 0 auto 16px;
}
.cta-form-row {
  display: flex; gap: 0;
}
.cta-input {
  flex: 1;
  background: rgba(255,255,255,0.1);
  border: 1px solid rgba(255,255,255,0.25);
  border-right: none;
  color: #fff; font-family: var(--sans); font-size: 14px;
  padding: 16px 22px; outline: none; font-weight: 300;
  border-radius: 4px 0 0 4px;
  transition: border-color 0.25s;
}
.cta-input.cta-input-last {
  border-right: 1px solid rgba(255,255,255,0.25);
  border-radius: 0 4px 4px 0;
}
.cta-input::placeholder { color: rgba(255,255,255,0.4); }
.cta-input:focus { border-color: var(--gold-light); }
.cta-submit {
  background: var(--gold);
  color: #fff; border: 1px solid var(--gold);
  padding: 16px 28px; font-family: var(--sans);
  font-size: 11px; font-weight: 600; letter-spacing: 0.2em;
  text-transform: uppercase; cursor: pointer;
  transition: background 0.25s; border-radius: 0 4px 4px 0;
}
.cta-submit:hover { background: var(--gold-dark); }
.cta-note { font-size: 11.5px; color: rgba(255,255,255,0.35); letter-spacing: 0.05em; }

/* ============================================================
   FLOATING CTA BUTTON
   ============================================================ */
.float-cta {
  position: fixed; bottom: 36px; right: 36px; z-index: 400;
  background: var(--gold); color: #fff;
  width: 56px; height: 56px; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 8px 28px rgba(201,168,76,0.4);
  text-decoration: none;
  transition: transform 0.25s var(--ease-spring), box-shadow 0.25s;
  animation: fadeIn 1s 2s both;
}
.float-cta:hover { transform: scale(1.12); box-shadow: 0 12px 36px rgba(201,168,76,0.5); }
.float-cta svg { width: 22px; height: 22px; fill: none; stroke: #fff; stroke-width: 2; }
.float-tooltip {
  position: absolute; right: 68px; top: 50%; transform: translateY(-50%);
  background: var(--bg-dark); color: #fff;
  font-size: 11.5px; white-space: nowrap; padding: 8px 14px;
  border-radius: 6px; opacity: 0; pointer-events: none;
  transition: opacity 0.22s;
}
.float-tooltip::after {
  content: ''; position: absolute; left: 100%; top: 50%;
  transform: translateY(-50%);
  border: 5px solid transparent; border-left-color: var(--bg-dark);
}
.float-cta:hover .float-tooltip { opacity: 1; }

/* ============================================================
   APARTMENTS SECTION — Filter + Cards
   ============================================================ */
.apartments-section {
  padding: 110px 56px 120px;
  background: var(--bg-white);
}
.apt-filter-bar {
  display: flex; gap: 8px; flex-wrap: wrap;
  margin-top: 48px; margin-bottom: 52px;
}
.apt-filter-btn {
  padding: 10px 24px; border-radius: 50px;
  border: 1.5px solid var(--border);
  background: transparent;
  font-size: 12px; font-weight: 500;
  letter-spacing: 0.08em; cursor: pointer;
  color: var(--text-secondary);
  transition: all 0.22s var(--ease);
  font-family: var(--sans);
}
.apt-filter-btn:hover { border-color: var(--gold); color: var(--gold); }
.apt-filter-btn.active {
  background: var(--gold); border-color: var(--gold);
  color: #fff;
  box-shadow: var(--shadow-gold);
}
.apt-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}
.apt-card {
  background: var(--bg-white);
  border: 1px solid var(--border);
  border-radius: 16px; overflow: hidden;
  transition: transform 0.32s var(--ease), box-shadow 0.32s var(--ease), border-color 0.32s;
  box-shadow: var(--shadow-sm);
  cursor: pointer;
}
.apt-card:hover {
  transform: translateY(-8px);
  box-shadow: var(--shadow-lg);
  border-color: var(--gold-pale);
}
.apt-img-wrap { position: relative; overflow: hidden; }
.apt-img {
  width: 100%; height: 240px; object-fit: cover; display: block;
  transition: transform 0.5s var(--ease);
}
.apt-card:hover .apt-img { transform: scale(1.06); }
.apt-badge {
  position: absolute; top: 14px; left: 14px;
  background: var(--bg-dark); color: var(--gold-light);
  font-size: 9.5px; letter-spacing: 0.18em; text-transform: uppercase;
  font-weight: 600; padding: 5px 12px; border-radius: 50px;
}
.apt-area-badge {
  position: absolute; top: 14px; right: 14px;
  background: rgba(255,255,255,0.92);
  backdrop-filter: blur(8px);
  font-size: 12px; font-weight: 600;
  color: var(--text-primary);
  padding: 5px 12px; border-radius: 6px;
}
.apt-info { padding: 22px 24px 26px; }
.apt-type {
  font-size: 10px; letter-spacing: 0.22em; text-transform: uppercase;
  color: var(--gold); font-weight: 500; margin-bottom: 8px;
}
.apt-name {
  font-family: var(--serif); font-size: 22px; font-weight: 500;
  color: var(--text-primary); margin-bottom: 12px; line-height: 1.2;
}
.apt-specs {
  display: flex; flex-wrap: wrap; gap: 16px;
  padding: 14px 0;
  border-top: 1px solid var(--border);
  border-bottom: 1px solid var(--border);
  margin-bottom: 16px;
}
.apt-spec {
  font-size: 12.5px; color: var(--text-secondary);
  display: flex; align-items: center; gap: 5px;
}
.apt-spec svg { stroke: var(--gold); }
.apt-footer {
  display: flex; align-items: center; justify-content: space-between;
}
.apt-price {
  font-family: var(--serif); font-size: 24px; font-weight: 500;
  color: var(--gold); line-height: 1;
}
.apt-price span { font-size: 12px; color: var(--text-secondary); font-family: var(--sans); margin-left: 4px; }
.apt-btn {
  font-size: 11px; font-weight: 600;
  letter-spacing: 0.12em; text-transform: uppercase;
  color: var(--text-primary); text-decoration: none;
  display: flex; align-items: center; gap: 6px;
  transition: color 0.22s;
}
.apt-btn:hover { color: var(--gold); }
.apt-btn svg { transition: transform 0.22s; }
.apt-btn:hover svg { transform: translateX(3px); }

/* ============================================================
   FOOTER
   ============================================================ */
footer {
  background: var(--bg-dark);
  padding: 80px 56px 36px;
}
.footer-top {
  display: grid; grid-template-columns: 2fr 1fr 1fr 1fr;
  gap: 56px; padding-bottom: 56px;
  border-bottom: 1px solid rgba(255,255,255,0.08);
}
.footer-logo {
  font-family: var(--serif);
  font-size: 20px; font-weight: 600; letter-spacing: 0.12em;
  color: var(--text-on-dark); text-decoration: none;
  display: flex; align-items: center; gap: 5px;
  margin-bottom: 18px;
}
.footer-logo .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--gold); }
.footer-desc {
  font-size: 13.5px; color: rgba(248,245,239,0.45);
  line-height: 1.85; max-width: 270px;
}
.footer-socials { display: flex; gap: 10px; margin-top: 26px; }
.f-soc {
  width: 36px; height: 36px; border-radius: 50%;
  border: 1px solid rgba(255,255,255,0.12);
  display: flex; align-items: center; justify-content: center;
  text-decoration: none; color: rgba(248,245,239,0.45);
  font-size: 12px; font-weight: 600; transition: all 0.25s;
}
.f-soc:hover { border-color: var(--gold); color: var(--gold); }
.f-col-title {
  font-size: 10px; letter-spacing: 0.25em; text-transform: uppercase;
  color: rgba(255,255,255,0.3); margin-bottom: 22px; font-weight: 600;
}
.f-links { list-style: none; display: flex; flex-direction: column; gap: 12px; }
.f-links a {
  font-size: 14px; color: rgba(248,245,239,0.45);
  text-decoration: none; transition: color 0.2s;
}
.f-links a:hover { color: var(--text-on-dark); }
.footer-bottom {
  display: flex; justify-content: space-between; align-items: center;
  padding-top: 28px;
  font-size: 12px; color: rgba(248,245,239,0.2);
}
.footer-bottom a { color: rgba(184,138,68,0.45); text-decoration: none; transition: color 0.2s; }
.footer-bottom a:hover { color: var(--gold); }
.footer-bottom-links { display: flex; gap: 22px; }

/* ============================================================
   RESPONSIVE
   ============================================================ */
@media (max-width: 1100px) {
  nav, .listings-section, .stats-strip, .features-section,
  .testimonials-section .test-header, .testimonials-section .test-controls,
  .blog-section, .process-section, .faq-section, .cta-section,
  footer, .amenities-wrap { padding-left: 32px !important; padding-right: 32px !important; }
  .hero-content { grid-template-columns: 1fr; padding: 0 40px 80px; }
  .hero-form-card { display: none; }
  .listing-grid { grid-template-columns: 1fr 1fr; }
  .l-card.featured { grid-column: 1 / 3; grid-row: auto; }
  .features-section { grid-template-columns: 1fr; }
  .feat-visual { min-height: 400px; }
  .stats-inner { grid-template-columns: 1fr 1fr; gap: 40px; }
  .stat-block { border-right: none; border-bottom: 1px solid var(--border); padding-bottom: 32px; }
  .stat-block:nth-child(even) { border-right: none; }
  .footer-top { grid-template-columns: 1fr 1fr; }
}
@media (max-width: 768px) {
  .nav-links { display: none; }
  .hero-h1 .indent { padding-left: 0; }
  .hero-content { padding: 0 24px 72px; }
  .hero-stats { display: none; }
  .listing-grid, .blog-grid, .process-grid { grid-template-columns: 1fr; }
  .l-card.featured, .b-card.featured { grid-column: auto; grid-row: auto; }
  .test-slide { grid-template-columns: 1fr; gap: 32px; }
  .faq-inner { grid-template-columns: 1fr; gap: 48px; }
  .stats-inner { grid-template-columns: 1fr 1fr; }
  .footer-top { grid-template-columns: 1fr; }
  .section-header { flex-direction: column; align-items: flex-start; gap: 16px; }
  .test-header { flex-direction: column; align-items: flex-start; gap: 16px; }
}
</style>
</head>
<body>

<!-- CUSTOM CURSOR (desktop only) -->
<div id="cursor-dot"  aria-hidden="true"></div>
<div id="cursor-ring" aria-hidden="true"></div>

<!-- NAVBAR -->
<nav id="nav">
  <a href="#" class="nav-logo">SANY<span class="nav-logo-dot"></span>HOLDING</a>
  <ul class="nav-links">
    <li><a href="#listings" data-en="Properties">Dự Án</a></li>
    <li><a href="#amenities" data-en="Amenities">Tiện Ích</a></li>
    <li><a href="#features" data-en="Services">Dịch Vụ</a></li>
    <li><a href="#blog">Insights</a></li>
    <li><a href="#process" data-en="Process">Quy Trình</a></li>
    <li><a href="#contact" class="nav-cta" data-en="Free Consultation">Tư Vấn Miễn Phí</a></li>
  </ul>
  <button id="lang-toggle" class="lang-btn" data-lang="vi">EN</button>
</nav>

<!-- ============================================================
     HERO
     ============================================================ -->
<section class="hero">
  <div class="hero-img"></div>
  <div class="hero-gradient"></div>

  <div class="hero-content">
    <!-- LEFT: Headline -->
    <div class="hero-left">
      <div class="hero-eyebrow">
        <div class="hero-eyebrow-bar"></div>
        <span data-en="Sany Holding &middot; Luxury Real Estate &middot; Vietnam">Sany Holding &middot; Luxury Real Estate &middot; Việt Nam</span>
      </div>
      <h1 class="hero-h1">
        <span data-en="Where prestige becomes &lt;em&gt;home&lt;/em&gt;">Nơi đẳng cấp<br>
        <span class="indent">trở thành <em>nhà</em></span></span>
      </h1>
      <p class="hero-desc" data-en="We craft timeless living spaces — where every detail is refined to elevate your way of life.">Chúng tôi kiến tạo những không gian sống vượt thời gian — nơi mỗi chi tiết được chắt lọc để nâng tầm cuộc sống của bạn.</p>
      <div class="hero-cta-row">
        <a href="#listings" class="btn-primary" data-en="Explore Projects">Khám Phá Dự Án</a>
        <a href="#process" class="btn-secondary">
          <div class="btn-secondary-circle">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </div>
          <span data-en="See process">Xem quy trình</span>
        </a>
      </div>
      <div class="hero-stats">
        <div class="h-stat"><div class="h-stat-n">1,200<sup>+</sup></div><div class="h-stat-l" data-en="Transactions">Giao Dịch</div></div>
        <div class="h-stat"><div class="h-stat-n">60K<sup>tỷ</sup></div><div class="h-stat-l" data-en="Total Value">Tổng Giá Trị</div></div>
        <div class="h-stat"><div class="h-stat-n">15<sup>+</sup></div><div class="h-stat-l" data-en="Years of Experience">Năm Kinh Nghiệm</div></div>
      </div>
    </div>

    <!-- RIGHT: Booking Form -->
    <div class="hero-form-card">
      <div class="hfc-title" data-en="Schedule a Viewing">Đặt Lịch Xem Dự Án</div>
      <div class="hfc-sub" data-en="Free &middot; No obligation &middot; Response within 2 hours">Miễn phí &middot; Không ràng buộc &middot; Phản hồi trong 2 giờ</div>
      <label class="hfc-label" data-en="Full Name">Họ và tên</label>
      <input id="hfc-name" type="text" class="hfc-input" placeholder="Nguyễn Văn A..." data-ph-en="Full Name..." required>
      <label class="hfc-label" data-en="Phone Number">Số điện thoại</label>
      <input id="hfc-phone" type="tel" class="hfc-input" placeholder="0901 234 567" data-ph-en="+84 901 234 567" required>
      <label class="hfc-label" data-en="Email">Email</label>
      <input id="hfc-email" type="email" class="hfc-input" placeholder="email@example.com">
      <button id="hfc-btn" class="hfc-submit" data-en="Book Free Viewing →">Đặt Lịch Miễn Phí →</button>
      <div id="hfc-msg" style="display:none;margin-top:12px;padding:10px 14px;border-radius:6px;font-size:13px;text-align:center;"></div>
      <div class="hfc-divider"><span data-en="or contact us directly">hoặc liên hệ trực tiếp</span></div>
      <div style="text-align:center">
        <a href="tel:02838228888" style="font-family:var(--serif);font-size:20px;color:var(--gold-light);text-decoration:none;font-weight:500;letter-spacing:0.05em;">+84 28 3822 8888</a>
      </div>
      <p class="hfc-note" data-en="🔒 Strictly confidential &middot; No spam">🔒 Thông tin bảo mật tuyệt đối &middot; Không spam</p>
    </div>
  </div>

  <div class="scroll-hint">
    <span>Scroll</span>
    <div class="scroll-line"></div>
  </div>
</section>

<!-- TICKER -->
<div class="ticker-wrap" aria-hidden="true">
  <div class="ticker-track">
    <span class="t-item"><span class="t-dot"></span>Luxury Living <strong>TP. Hồ Chí Minh</strong></span>
    <span class="t-item"><span class="t-dot"></span>Premium Residences <strong>Quận 1 &amp; Quận 2</strong></span>
    <span class="t-item"><span class="t-dot"></span>Trusted Since <strong>2009</strong></span>
    <span class="t-item"><span class="t-dot"></span><strong>60.000 Tỷ VND</strong> Giao Dịch</span>
    <span class="t-item"><span class="t-dot"></span><strong>1,200+</strong> Properties Sold</span>
    <span class="t-item"><span class="t-dot"></span>Award-Winning <strong>Agency</strong></span>
    <span class="t-item"><span class="t-dot"></span>Luxury Living <strong>TP. Hồ Chí Minh</strong></span>
    <span class="t-item"><span class="t-dot"></span>Premium Residences <strong>Quận 1 &amp; Quận 2</strong></span>
    <span class="t-item"><span class="t-dot"></span>Trusted Since <strong>2009</strong></span>
    <span class="t-item"><span class="t-dot"></span><strong>60.000 Tỷ VND</strong> Giao Dịch</span>
    <span class="t-item"><span class="t-dot"></span><strong>1,200+</strong> Properties Sold</span>
    <span class="t-item"><span class="t-dot"></span>Award-Winning <strong>Agency</strong></span>
  </div>
</div>

<!-- ============================================================
     LISTINGS
     ============================================================ -->
<section class="listings-section" id="listings">
  <div class="section-header reveal">
    <div>
      <div class="section-label" data-en="Curated Listings">Danh Mục Tinh Chọn</div>
      <h2 class="section-title" data-en="Homes carefully &lt;em&gt;selected&lt;/em&gt;">Những ngôi nhà<br>được <em>chọn lọc</em></h2>
    </div>
    <div style="display:flex;flex-direction:column;align-items:flex-end;gap:12px">
      <a href="#" class="view-all" data-en="View all properties">Xem tất cả dự án</a>
      <p style="font-size:13px;color:var(--text-secondary);max-width:240px;text-align:right;line-height:1.7" data-en="Every property is thoroughly vetted for legal compliance and quality.">Mỗi bất động sản được kiểm định kỹ lưỡng về pháp lý và chất lượng.</p>
    </div>
  </div>

  <div class="listing-grid">

    <!-- FEATURED -->
    <a href="#" class="l-card featured reveal">
      <div class="l-img-wrap">
