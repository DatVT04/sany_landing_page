  </div>
</section>

<!-- ============================================================
     AMENITIES
     ============================================================ -->
<div class="amenities-wrap" id="amenities">
  <div class="reveal">
    <div class="section-label" data-en="World-Class Amenities">Tiện Ích Đẳng Cấp</div>
    <h2 class="section-title" data-en="Live every &lt;em&gt;moment&lt;/em&gt; fully">Sống trọn vẹn từng <em>khoảnh khắc</em></h2>
  </div>

  <div class="bento-grid">

    <div class="bento-cell c-1 img-cell reveal">
      <img src="https://images.unsplash.com/photo-1571896349842-33c89424de2d?w=900&q=85" alt="Pool" class="b-img" loading="lazy">
      <div class="b-overlay"></div>
      <span class="b-pill">Sky Pool</span>
      <div class="b-label"><div class="b-label-name">Infinity Rooftop Pool</div><div class="b-label-sub" data-en="Floor 50 · 360° city view">Tầng 50 · View 360° thành phố</div></div>
    </div>

    <div class="bento-cell c-2 img-cell reveal d1">
      <img src="https://images.unsplash.com/photo-1534438327276-14e5300c3a48?w=700&q=85" alt="Gym" class="b-img" loading="lazy">
      <div class="b-overlay"></div>
      <span class="b-pill">Fitness</span>
      <div class="b-label"><div class="b-label-name">Fitness Center 24/7</div></div>
    </div>

    <div class="bento-cell c-3 stat-cell gold-cell reveal d2">
      <div class="b-stat-icon"><svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg></div>
      <div>
        <div class="b-stat-n">40<em>+</em></div>
        <div class="b-stat-label" data-en="Premium Amenities">Tiện Ích Cao Cấp</div>
      </div>
    </div>

    <div class="bento-cell c-4 img-cell reveal d1">
      <img src="https://images.unsplash.com/photo-1555396273-367ea4eb4db5?w=700&q=85" alt="Dining" class="b-img" loading="lazy">
      <div class="b-overlay"></div>
      <span class="b-pill">Dining</span>
      <div class="b-label"><div class="b-label-name">Sky Lounge &amp; Restaurant</div></div>
    </div>

    <div class="bento-cell c-5 stat-cell reveal d2">
      <div class="b-stat-icon"><svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></div>
      <div>
        <div class="b-stat-n">24<em>/7</em></div>
        <div class="b-stat-label" data-en="Security">An Ninh Bảo Vệ</div>
      </div>
    </div>

    <div class="bento-cell c-6 img-cell reveal d1">
      <img src="https://images.unsplash.com/photo-1497366216548-37526070297c?w=1000&q=85" alt="Lobby" class="b-img" loading="lazy">
      <div class="b-overlay"></div>
      <span class="b-pill">Grand Lobby</span>
      <div class="b-label"><div class="b-label-name" data-en="5-Star Grand Lobby">Sảnh Đón Khách 5 Sao</div><div class="b-label-sub" data-en="Imported furnishings · Concierge 24/7">Nội thất nhập khẩu · Concierge 24/7</div></div>
